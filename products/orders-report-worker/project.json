{
  "name": "orders-report-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "products/orders-report-worker/src",
  "projectType": "application",
  "tags": [
    "type:product",
    "scope:factory"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/products/orders-report-worker"
      ],
      "options": {
        "command": "tsc -p products/orders-report-worker/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root . products/orders-report-worker",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/materials/orders-api/generated/**/*",
        "{workspaceRoot}/materials/orders-api/test/fixtures/**/*",
        "{workspaceRoot}/products/orders-service/test-support/**/*"
      ]
    }
  },
  "implicitDependencies": [
    "orders-api",
    "orders-service"
  ]
}
