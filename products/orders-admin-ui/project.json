{
  "name": "orders-admin-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "products/orders-admin-ui/src",
  "projectType": "application",
  "tags": [
    "type:product",
    "scope:factory"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/products/orders-admin-ui"
      ],
      "options": {
        "command": "ngc -p products/orders-admin-ui/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root . products/orders-admin-ui",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
