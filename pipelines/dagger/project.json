{
  "name": "pipelines-dagger",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "pipelines/dagger/src",
  "projectType": "library",
  "tags": ["type:tool", "scope:pipelines"],
  "targets": {
    "build": { "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/pipelines/dagger"], "options": { "command": "tsc -p pipelines/dagger/tsconfig.lib.json", "cwd": "{workspaceRoot}" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --root . pipelines/dagger --passWithNoTests", "cwd": "{workspaceRoot}" } }
  }
}
