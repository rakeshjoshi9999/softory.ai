{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Factory packages pinned in product lockfiles (written by `factory assemble`)",
      "managerFilePatterns": ["/(^|/)products/[^/]+/product\\.lock\\.json$/"],
      "matchStrings": ["\"(?<depName>@factory/[^\"]+)\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "npm",
      "registryUrlTemplate": "http://localhost:4873/"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@factory/*"],
      "groupName": "factory packages",
      "groupSlug": "factory-packages",
      "registryUrls": ["http://localhost:4873/"]
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@factory/*"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0
}
