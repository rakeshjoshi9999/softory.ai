{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://softory.ai/schemas/factory/v1/material.schema.json",
  "title": "Material",
  "description": "A raw material: one spec source plus how it is validated and emitted. See docs/architecture.md#material-model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "factory/v1" },
    "kind": { "const": "Material" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "owner", "version"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "type": {
          "enum": ["model", "api-contract", "event", "tokens", "component", "policy", "pipeline-block", "chart"]
        },
        "owner": { "$ref": "#/definitions/name" },
        "version": {
          "description": "Semantic version, set by Changesets.",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "format"],
      "properties": {
        "source": {
          "description": "Spec source file, relative to the material folder.",
          "type": "string",
          "minLength": 1
        },
        "format": {
          "description": "Spec source format, e.g. typespec.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "emitters": {
          "description": "Emitter references as <emitter>@<major>, e.g. ts-angular-client@1.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/pluginRef" }
        },
        "dependsOn": {
          "description": "Other materials as <material>@<range>, e.g. orders-model@^1.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/materialRef" }
        },
        "compatibility": { "enum": ["backward", "forward", "full", "none"] }
      }
    }
  },
  "definitions": {
    "name": {
      "description": "Lower-case kebab-case identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "pluginRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*@[0-9]+$"
    },
    "materialRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*@[^\\s@]+$"
    }
  }
}
