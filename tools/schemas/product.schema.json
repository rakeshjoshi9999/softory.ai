{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://softory.ai/schemas/factory/v1/product.schema.json",
  "title": "Product",
  "description": "A product manifest: a recipe plus the materials it consumes and how it is delivered. See docs/architecture.md#product-model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "factory/v1" },
    "kind": { "const": "Product" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "owner": { "$ref": "#/definitions/name" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe"],
      "properties": {
        "recipe": {
          "description": "Recipe reference as <recipe>@<major>, e.g. angular-remote@1.",
          "$ref": "#/definitions/pluginRef"
        },
        "consumes": {
          "description": "Materials this product uses, keyed by a local alias: <alias>: <material>@<range>.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/alias" },
          "additionalProperties": { "$ref": "#/definitions/materialRef" }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pipeline"],
          "properties": {
            "pipeline": { "$ref": "#/definitions/pluginRef" },
            "envs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/name" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "name": {
      "description": "Lower-case kebab-case identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*$"
    },
    "pluginRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*@[0-9]+$"
    },
    "materialRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*@[^\\s@]+$"
    }
  }
}
